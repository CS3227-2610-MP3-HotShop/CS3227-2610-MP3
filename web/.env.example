# The pooled connection string (Supabase's transaction pooler, port 6543).
#
# TLS: you do not need to put `sslmode` here. Any host that is not this machine
# gets `sslmode=verify-full` automatically, which encrypts AND checks the
# server's certificate. Do not "fix" a certificate error by adding
# `?sslmode=require`: postgres.js turns `require`, `allow` and `prefer` into
# `rejectUnauthorized: false`, so the connection is encrypted to whoever
# answered, verified against nothing, and the password is readable by anything
# in the path. If you genuinely need a custom CA, say so explicitly with
# `?sslmode=verify-full&sslrootcert=...`.
#
# A loopback host (localhost, 127.0.0.0/8, ::1, a unix socket) stays plaintext,
# because those bytes never reach a network interface. That is what makes the
# docker-compose setup below work unchanged. An explicit `?sslmode=` in the URL
# always wins over both rules, including `?sslmode=disable`.
DATABASE_URL=

# The direct connection (port 5432), for migrations and anything the
# transaction pooler cannot run. Same TLS rules.
DATABASE_URL_DIRECT=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=
APP_TIMEZONE=

# The database the tests run against. Deliberately a SEPARATE variable from
# DATABASE_URL, with no fallback: if this is unset the database tests fail with
# a message instead of quietly borrowing the application database, and if it
# names the same database as DATABASE_URL the run is refused outright.
#
# Put the real value in `.env.test.local`, which is gitignored. With the bundled
# docker-compose.yml:
#
#   DATABASE_URL_TEST=postgresql://hotshop:hotshop@localhost:55432/hotshop_test
#
# Any PostgreSQL 13 or newer works; Docker is only a convenience. The account
# needs CREATEDB, because the suite makes a database per run and drops it after.
DATABASE_URL_TEST=
